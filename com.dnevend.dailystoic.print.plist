<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dnevend.dailystoic.print</string>

    <!-- 使用项目虚拟环境里的命令行入口 -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/dnevend/Projects/daily-stoic/.venv/bin/dailyprint</string>
        <string>print</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/dnevend/Projects/daily-stoic</string>

    <!-- lp（CUPS）需要 PATH -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- 每天早上 9:00 打印最新一篇；睡眠中错过的任务会在唤醒后补跑 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/dnevend/Projects/daily-stoic/logs/print.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dnevend/Projects/daily-stoic/logs/print.err</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
