<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dnevend.dailystoic.print</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/dnevend/Projects/daily-stoic/daily_print.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/dnevend/Projects/daily-stoic</string>

    <!-- 每天早上 9:00 打印最新一篇 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/dnevend/Projects/daily-stoic/logs/print.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dnevend/Projects/daily-stoic/logs/print.err</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
